{
  "extends": "claude",
  "meta": {
    "name": "claude-sandboxed"
  },
  "groups": {
    "include": [],
    "exclude": []
  },
  "commands": {
    "allow": [],
    "deny": []
  },
  "security": {
    // Babashka is a GraalVM native image and opens a POSIX semaphore at
    // startup. The inherited default denies semaphores, so every bb script
    // (,roam and friends) dies with:
    //
    //   CSunMiscSignal.open() failed.  errno: 1  Operation not permitted
    //
    // Despite the name that is IPC, not signals -- signal_mode is not the fix.
    "ipc_mode": "full"
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": ["~/Documents", "~/dotfiles"],
    "read": [],
    "write": [],
    "allow_file": [],
    "read_file": [],
    "write_file": [],
    "deny": [],
    "bypass_protection": [],
    "suppress_save_prompt": []
  },
  "network": {
    "block": false,
    "allow_domain": [],
    "credentials": [],
    "open_port": [],
    "listen_port": [],
    "custom_credentials": {}
  },
  "env_credentials": {},
  "hooks": {},
  "rollback": {
    "exclude_patterns": [],
    "exclude_globs": []
  }
}
