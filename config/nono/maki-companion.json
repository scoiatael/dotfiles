// Sandbox for the read-only maki companion agent -- both the ACP server
// Emacs drives and the terminal TUI session. Launched by the `maki-companion'
// script in modules/aspects/companion.nix.
// nono parses JSONC, so these comments are fine; unknown *keys* are not.
{
  "extends": "default",
  "meta": {
    "name": "maki-companion",
    "description": "Read-only maki companion agent, over ACP or as a TUI"
  },
  "groups": {
    "include": [
      "nix_runtime",
      "git_config",
      "unlink_protection",
      { "name": "system_read_macos", "when": "macos" },
      { "name": "system_write_macos", "when": "macos" },
      { "name": "user_caches_macos", "when": "macos" }
    ]
  },
  "security": {
    // Babashka is a GraalVM native image, and its startup opens a POSIX
    // semaphore. Under the default "shared_memory_only" that is denied and
    // every bb script dies before running:
    //
    //   CSunMiscSignal.open() failed.  errno: 1  Operation not permitted
    //
    // The name points at signals, but signal_mode is not the fix -- semaphores
    // are IPC. "full" is what enables them. Without this, the ,roam / ,hm-eval
    // style helpers the skills depend on are all unusable.
    "ipc_mode": "full"
  },
  "workdir": {
    // The whole point: the project is readable, never writable. Needs
    // --allow-cwd on the command line, which is mandatory anyway when
    // interactive is false.
    "access": "read"
  },
  "filesystem": {
    "allow": [
      "$HOME/.local/state/maki",
      // Scratch space for one-off scripts. The launcher points TMPDIR here so
      // anything using mktemp stays inside the grant.
      "/tmp/maki-companion-$UID",
      // SQLite must create WAL/journal files beside the database even to read
      // it, so a read-only .codegraph/ fails with "unable to open database
      // file". Expanded from --workdir on the launcher.
      "$WORKDIR/.codegraph"
    ],
    "read": [
      "$HOME/.config/maki",
      // maki discovers skills from ~/.claude/skills. Without this only its
      // builtin skill is found. Deliberately not all of ~/.claude, which also
      // holds credentials.
      "$HOME/.claude/skills",
      // In a project with no index, codegraph walks up looking for one and
      // stats this. Denied, that is fatal ("EPERM ... stat '$HOME/.codegraph'")
      // and its MCP server never starts; granted, the stat returns ENOENT and
      // codegraph starts without an index, as it does outside the sandbox.
      // Only this path needs it -- other $HOME subdirectories already ENOENT.
      "$HOME/.codegraph",
      // gh refuses to start without both of these, even with GH_TOKEN set in
      // the environment (the launcher resolves it outside the sandbox, since
      // the real token is in the keychain). Neither file holds a secret here;
      // named individually rather than granting all of ~/.config/gh.
      "$HOME/.config/gh/config.yml",
      "$HOME/.config/gh/hosts.yml",
      "$NONO_CONFIG/profiles",
      "$NONO_PACKAGES"
    ]
  },
  "network": {
    "block": false,
    // Kagi's MCP server. A no-op on macOS -- Seatbelt cannot filter outbound
    // connections by port -- but it is what grants this on Linux.
    "open_port": [8081]
  },
  // A save-profile prompt has nowhere to go in either mode: in ACP it would
  // land in the stdio stream and corrupt the JSON-RPC framing, and in the TUI
  // it would fight maki for the terminal. In ACP the launcher also passes
  // --silent, for the same reason.
  "interactive": false
}
